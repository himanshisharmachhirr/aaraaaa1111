<section class="page-hero">
    <h1>Contact Us</h1>
    <p>We are here to help with your travel requirements.</p>
</section>

<section class="contact-section">

    <div class="contact-info">

        <h2>Business Information</h2>

        <p>
            👩‍💼 <strong>Owner:</strong><br>
            Himanshi Sharma
        </p>

        <p>
            📅 <strong>Established:</strong><br>
            1992
        </p>

        <p>
            📞 <strong>Phone:</strong><br>
            <a href="tel:9785770641">9785770641</a>
        </p>

        <p>
            📍 <strong>Address:</strong><br>
            Chhirr Balaji Dham,<br>
            Jaipur, Rajasthan, India
        </p>

        <a
            class="whatsapp-btn"
            href="https://wa.me/919785770641"
            target="_blank"
        >
            💬 WhatsApp Us
        </a>

    </div>

    <div class="contact-form">

        <h2>Send a Message</h2>

        <form onsubmit="sendMessage(event)">

            <input
                type="text"
                id="contactName"
                placeholder="Your Name"
                required
            >

            <input
                type="tel"
                id="contactPhone"
                placeholder="Phone Number"
                required
            >

            <input
                type="email"
                id="contactEmail"
                placeholder="Email"
                required
            >

            <textarea
                id="contactMessage"
                rows="6"
                placeholder="Your message"
                required
            ></textarea>

            <button type="submit">
                Send on WhatsApp
            </button>

        </form>

    </div>

</section>

